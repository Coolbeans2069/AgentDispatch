# AgentDispatch configuration. Copy to .env (git-ignored) and load it into your shell,
# e.g. `set -a; . ./.env; set +a`. Every value here is a placeholder.

# --- where the broker keeps its state (board database, tokens, audit log, job workspaces)
AGENTDISPATCH_DATA=./data

# --- host folders (comma-separated lists)
AGENTDISPATCH_PROJECTS_ROOT=~/agentdispatch-projects
AGENTDISPATCH_ALLOWED_ROOTS=~/agentdispatch-projects
AGENTDISPATCH_SAFE_REPOS=
AGENTDISPATCH_WORK_DIR=
AGENTDISPATCH_FARM_PATHS=

# --- optional cloud model keys (leave empty to run local-only)
OPENROUTER_API_KEY=your-openrouter-key-here
GEMINI_API_KEY=your-gemini-key-here

# --- optional local services
OLLAMA_URL=http://127.0.0.1:11434
ENGINEROOM_URL=http://127.0.0.1:8898

# --- Engine Room (python -m engineroom); every value is optional
ENGINEROOM_HOST=127.0.0.1
ENGINEROOM_PORT=8898
# state folder for counters, limits and metrics (default ~/.agentdispatch/engineroom)
ENGINEROOM_DATA=
# plan-limit store (default <ENGINEROOM_DATA>/limits.json)
ENGINEROOM_LIMITS_FILE=
# extra process names to count as bots, comma-separated
ENGINEROOM_AUTO=
# process names of your pull agent(s), comma-separated
ENGINEROOM_PULL_AGENT_PATTERNS=
# path to the codex binary for live limit reads (default: found on PATH)
ENGINEROOM_CODEX_BIN=
# set to 1 to skip the live Claude/Codex limit reads
ENGINEROOM_NO_LIVE_LIMITS=
# where the Engine Room finds the broker for its AGENCY panel
AGENTDISPATCH_URL=http://127.0.0.1:8870
# Ollama server log for request/duty figures (default: the platform's standard location)
OLLAMA_LOG=

# --- optional local tools (speech to text, face matching)
AD_DEVICE=cpu
AD_MODEL_DIR=
AD_LANGUAGE=
AD_GALLERY=
AD_SIM_MIN=0.40
