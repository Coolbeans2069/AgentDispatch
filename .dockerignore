# keep the build context small and free of secrets and local state
.git
.github
.gitattributes
.dockerignore
Dockerfile
docker-compose*.yml
compose*.yml

# runtime state, keys and local config
data/
**/data/
b1demo-data/
.env
.env.*
!.env.example
*.key
*.pem
*.p12
tokens.json
token.txt
*.db
*.sqlite
*.sqlite3
*.sqlite-*
*.log
*.jsonl

# Python caches, virtual environments and build output
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/
build/
dist/
*.egg-info/

# not needed in the image
tests/
docs/
examples/
tools/
*.bak
.idea/
.vscode/
